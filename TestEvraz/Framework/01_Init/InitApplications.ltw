                        <Name>Script</Name>
                        <Value xsi:type="xsd:string">// Метод валидации URL
checkURL = (url, paramName) =&gt;
{
    if (Uri.TryCreate(url, UriKind.Absolute, out Uri uriResult) 
        &amp;&amp; (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps))
    {
        return url;
    }
    throw new ArgumentException($"Параметр '{paramName}' содержит некорректный URL: '{url}'");
};</Value>
