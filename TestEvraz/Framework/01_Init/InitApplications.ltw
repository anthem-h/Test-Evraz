                <Components>
                    <SerializationComponent>
                        <ClassName>LTools.Workflow.Elements.Script.WFCSScript</ClassName>
                        <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                        <Properties>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Message</Name>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Script</Name>
                                <Value xsi:type="xsd:string">// 1. Папка Default
string chromeDefaultDir = Path.Combine(Config["chromeUserDataPath"].ToString().Trim(), "Default");
string prefsPath = Path.Combine(chromeDefaultDir, "Preferences");

// Создаем папку Default, чтобы было куда положить Preferences
if (!Directory.Exists(chromeDefaultDir))
{
    Directory.CreateDirectory(chromeDefaultDir);
}

// 2. Считываем JSON файла (если есть) или берем пустой
string json = File.Exists(prefsPath) ? File.ReadAllText(prefsPath) : "{}";
JObject prefs = JObject.Parse(json);

// 3. Гарантируем наличие секции "download"
if (prefs["download"] == null)
{
    prefs["download"] = new JObject();
}

// 4. Включаем показ диалогового окна "Сохранить как..."
prefs["download"]["prompt_for_download"] = true;

// 5. Сохраняем изменения обратно в файл
File.WriteAllText(prefsPath, prefs.ToString());</Value>
